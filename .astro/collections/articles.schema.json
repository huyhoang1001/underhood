{
  "$ref": "#/definitions/articles",
  "definitions": {
    "articles": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "integer",
                  "format": "unix-time"
                }
              ]
            }
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "published"
          ],
          "default": "draft"
        },
        "topic": {
          "type": "string",
          "enum": [
            "distributed-systems",
            "backend-engineering",
            "performance",
            "system-design",
            "cloud-infrastructure",
            "engineering-experiments",
            "lessons-learned"
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "featured": {
          "type": "boolean",
          "default": false
        },
        "relatedArticles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "relatedExperiments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "githubUrl": {
          "type": "string",
          "format": "uri"
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "description",
        "date",
        "topic",
        "tags"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}