---
import { ArrowUp, Rss } from '@lucide/astro';
import { TOPIC_LIST } from '../data/topics';
---

<footer class="w-full border-t border-[#e7e3da] dark:border-[#30363d] bg-[#fbf9f5] dark:bg-[#0d1117] text-xs text-[#78716c] dark:text-[#8b949e] py-12 transition-colors">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 pb-10 border-b border-[#e7e3da] dark:border-[#30363d]">
      <!-- Brand & Editorial Column (5 cols) -->
      <div class="md:col-span-5 space-y-3">
        <div class="flex items-center gap-2">
          <span class="text-base font-bold tracking-tight text-[#1c1917] dark:text-[#f0f6fc]">
            Underhood
          </span>
          <span class="text-xs text-[#a8a29e] dark:text-[#6e7681]">·</span>
          <span class="text-xs font-mono text-[#78716c] dark:text-[#8b949e]">
            Engineering beyond the surface.
          </span>
        </div>
        <p class="text-xs leading-relaxed text-[#78716c] dark:text-[#8b949e] max-w-sm">
          An independent technical publication exploring distributed consensus, high-throughput systems, tail latency, and what breaks under pressure.
        </p>
        <div class="flex items-center gap-4 pt-2">
          <button
            onclick="window.dispatchEvent(new CustomEvent('open-rss-modal'))"
            class="flex items-center gap-1.5 hover:text-[#1c1917] dark:hover:text-[#f0f6fc] transition-colors cursor-pointer"
            aria-label="Open RSS feed modal"
          >
            <Rss class="w-3.5 h-3.5 text-amber-500" />
            <span>RSS Feed</span>
          </button>
          <a
            href="https://github.com/huyhoang1001/underhood"
            target="_blank"
            rel="noreferrer"
            class="flex items-center gap-1.5 hover:text-[#1c1917] dark:hover:text-[#f0f6fc] transition-colors"
          >
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
            <span>GitHub Source</span>
          </a>
        </div>
      </div>

      <!-- Navigation Tracks (3 cols) -->
      <div class="md:col-span-3 space-y-2.5">
        <div class="font-semibold text-xs uppercase tracking-wider text-[#1c1917] dark:text-[#f0f6fc]">
          Navigation
        </div>
        <ul class="space-y-1.5">
          <li>
            <a
              href="/writing"
              class="hover:text-[#1c1917] dark:hover:text-[#f0f6fc] transition-colors"
            >
              All Articles
            </a>
          </li>
          <li>
            <a
              href="/experiments"
              class="hover:text-[#1c1917] dark:hover:text-[#f0f6fc] transition-colors"
            >
              Engineering Lab
            </a>
          </li>
          <li>
            <a
              href="/topics"
              class="hover:text-[#1c1917] dark:hover:text-[#f0f6fc] transition-colors"
            >
              Topic Directory
            </a>
          </li>
          <li>
            <a
              href="/about"
              class="hover:text-[#1c1917] dark:hover:text-[#f0f6fc] transition-colors"
            >
              Author & Principles
            </a>
          </li>
        </ul>
      </div>

      <!-- Core Domains (4 cols) -->
      <div class="md:col-span-4 space-y-2.5">
        <div class="font-semibold text-xs uppercase tracking-wider text-[#1c1917] dark:text-[#f0f6fc]">
          Core Disciplines
        </div>
        <div class="grid grid-cols-2 gap-x-2 gap-y-1.5">
          {TOPIC_LIST.slice(0, 6).map((topic) => (
            <a
              href={`/topics/${topic.id}`}
              class="text-left text-xs truncate hover:text-sky-600 dark:hover:text-sky-400 transition-colors"
            >
              {topic.name}
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- Bottom row -->
    <div class="pt-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-[#a8a29e] dark:text-[#6e7681]">
      <div>
        © {new Date().getFullYear()} Underhood Engineering. Crafted for high-fidelity technical reading.
      </div>
      <button
        onclick="window.scrollTo({ top: 0, behavior: 'smooth' })"
        class="flex items-center gap-1.5 hover:text-[#1c1917] dark:hover:text-[#f0f6fc] transition-colors cursor-pointer"
        aria-label="Back to top"
      >
        <span>Back to top</span>
        <ArrowUp class="w-3.5 h-3.5" />
      </button>
    </div>
  </div>
</footer>
