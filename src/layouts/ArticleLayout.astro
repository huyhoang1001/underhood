---
import BaseLayout from './BaseLayout.astro';
import { Calendar, Clock, Link as LinkIcon, ArrowLeft } from '@lucide/astro';
import { Github } from 'lucide-react';
import { TableOfContents } from '../components/TableOfContents';

interface Props {
  title: string;
  description: string;
  date: string;
  topic: string;
  tags?: string[];
  readingTime?: string;
  wordCount?: number;
  githubUrl?: string;
  isDraft?: boolean;
  toc?: Array<{ id: string; text: string; level: number }>;
  relatedArticles?: Array<{ slug: string; title: string; readingTime: string }>;
}

const {
  title,
  description,
  date,
  topic,
  tags = [],
  readingTime = "5 min read",
  wordCount = 1000,
  githubUrl,
  isDraft = false,
  toc = [],
  relatedArticles = []
} = Astro.props;
---

<BaseLayout title={`${title} — Underhood`} description={description} ogType="article">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8 sm:py-12">
    <!-- Back to Writing Breadcrumb -->
    <div class="mb-8">
      <a
        href="/writing"
        class="inline-flex items-center gap-1.5 text-xs font-medium text-[#78716c] dark:text-[#8b949e] hover:text-[#1c1917] dark:hover:text-[#f0f6fc] transition-colors"
      >
        <ArrowLeft class="w-3.5 h-3.5" />
        <span>Back to all writing</span>
      </a>
    </div>

    <!-- Article Header -->
    <header class="space-y-4 max-w-3xl pb-8 border-b border-[#e7e3da] dark:border-[#30363d]">
      <!-- Zero-pill clean unboxed metadata -->
      <div class="flex flex-wrap items-center gap-2 text-xs text-[#78716c] dark:text-[#8b949e]">
        <a
          href={`/topics/${topic}`}
          class="font-semibold text-sky-600 dark:text-sky-400 hover:underline uppercase tracking-wider text-[11px]"
        >
          {topic.replace(/-/g, ' ')}
        </a>
        <span>·</span>
        <span class="flex items-center gap-1">
          <Calendar class="w-3 h-3 text-[#a8a29e] dark:text-[#6e7681]" />
          {date}
        </span>
        <span>·</span>
        <span
          class="flex items-center gap-1.5"
          title={`${wordCount.toLocaleString()} words · calculated at 200 words per minute baseline`}
        >
          <Clock class="w-3 h-3 text-[#a8a29e] dark:text-[#6e7681]" />
          <span class="font-medium text-[#1c1917] dark:text-[#f0f6fc]">
            {readingTime}
          </span>
          <span class="text-[11px] text-[#a8a29e] dark:text-[#6e7681] font-mono">
            ({wordCount.toLocaleString()} words @ 200 wpm)
          </span>
        </span>
        {isDraft && (
          <>
            <span>·</span>
            <span class="font-mono text-amber-700 dark:text-amber-400 font-semibold text-[11px] uppercase tracking-wider">
              [Local Review Draft]
            </span>
          </>
        )}
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-[#1c1917] dark:text-[#f0f6fc] leading-tight text-balance">
        {title}
      </h1>

      <p class="text-base sm:text-lg text-[#78716c] dark:text-[#8b949e] leading-relaxed">
        {description}
      </p>

      <!-- Action bar: GitHub repro link, Tags -->
      <div class="flex items-center justify-between pt-2 text-xs">
        <div class="flex items-center gap-2 text-[#a8a29e] dark:text-[#6e7681]">
          {tags.map((tag, idx) => (
            <span>
              {idx > 0 && <span class="mr-2">·</span>}
              <a
                href={`/writing?tag=${tag}`}
                class="hover:underline hover:text-sky-600 dark:hover:text-sky-400"
              >
                #{tag}
              </a>
            </span>
          ))}
        </div>

        <div class="flex items-center gap-2">
          {githubUrl && (
            <a
              href={githubUrl}
              target="_blank"
              rel="noreferrer"
              class="flex items-center gap-1.5 px-2.5 py-1 text-xs text-[#78716c] dark:text-[#8b949e] hover:text-[#1c1917] dark:hover:text-[#f0f6fc] bg-[#f2ede4] dark:bg-[#161b22] border border-[#e7e3da] dark:border-[#30363d] rounded transition-colors"
              title="View reproducible test harness on GitHub"
            >
              <Github class="w-3.5 h-3.5" />
              <span class="hidden sm:inline">Repro Harness</span>
            </a>
          )}
        </div>
      </div>
    </header>

    <!-- Main Two-Column Reading Canvas: Prose & Sticky TOC -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 mt-10">
      <!-- Article Body Content (8 cols) -->
      <main class="lg:col-span-8 max-w-prose text-[#1c1917] dark:text-[#e6edf3] leading-relaxed">
        <div class="prose dark:prose-invert max-w-none">
          <slot />
        </div>
      </main>

      <!-- Right Sidebar: Table of Contents & Related Investigations (4 cols) -->
      <aside class="hidden lg:block lg:col-span-4 space-y-10 pl-4">
        {toc.length > 0 && <TableOfContents client:visible items={toc} />}

        {relatedArticles.length > 0 && (
          <div class="space-y-3 pt-6 border-t border-[#e7e3da] dark:border-[#30363d]">
            <div class="font-semibold uppercase tracking-wider text-[11px] text-[#1c1917] dark:text-[#f0f6fc]">
              Related Investigations
            </div>
            <div class="space-y-3">
              {relatedArticles.map((rel) => (
                <a
                  href={`/writing/${rel.slug}`}
                  class="group block space-y-1"
                >
                  <div class="text-xs font-semibold text-[#1c1917] dark:text-[#f0f6fc] group-hover:text-sky-600 dark:group-hover:text-sky-400 transition-colors line-clamp-2">
                    {rel.title}
                  </div>
                  <div class="text-[11px] text-[#78716c] dark:text-[#8b949e]">
                    {rel.readingTime}
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}
      </aside>
    </div>
  </div>
</BaseLayout>
