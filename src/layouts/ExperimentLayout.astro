---
import BaseLayout from './BaseLayout.astro';
import { ArrowLeft, BookOpen, Sliders, CheckCircle2, AlertCircle } from '@lucide/astro';
import { Github } from 'lucide-react';
import { ExperimentVisualizer } from '../components/ExperimentVisualizer';

interface Props {
  title: string;
  tagline: string;
  date: string;
  topic: string;
  status: string;
  hypothesis: string;
  setup: string;
  implementation: string;
  keyFindings: string[];
  limitations?: string[];
  githubRepo: string;
  relatedArticleSlug?: string;
  interactiveType?: 'node-threadpool' | 'queue-backpressure' | 'grpc-multiplex' | 'cache-invalidation';
}

const {
  title,
  tagline,
  date,
  topic,
  status,
  hypothesis,
  setup,
  implementation,
  keyFindings,
  limitations = [],
  githubRepo,
  relatedArticleSlug,
  interactiveType = 'node-threadpool'
} = Astro.props;
---

<BaseLayout title={`${title} — Underhood Experiments`} description={tagline}>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-8 sm:py-12 space-y-10">
    <a
      href="/experiments"
      class="inline-flex items-center gap-1.5 text-xs font-medium text-[#78716c] dark:text-[#8b949e] hover:text-[#1c1917] dark:hover:text-[#f0f6fc] transition-colors"
    >
      <ArrowLeft class="w-3.5 h-3.5" />
      <span>All laboratory experiments</span>
    </a>

    <!-- Experiment Header -->
    <header class="space-y-4 max-w-3xl pb-8 border-b border-[#e7e3da] dark:border-[#30363d]">
      <div class="flex flex-wrap items-center gap-2 text-xs font-mono text-[#78716c] dark:text-[#8b949e]">
        <a
          href={`/topics/${topic}`}
          class="font-semibold text-sky-600 dark:text-sky-400 uppercase tracking-wider text-[11px] hover:underline"
        >
          {topic.replace(/-/g, ' ')}
        </a>
        <span>·</span>
        <span>Lab Test Run: {date}</span>
        {status === 'draft' && (
          <>
            <span>·</span>
            <span class="font-mono text-amber-700 dark:text-amber-400 font-semibold text-[11px] uppercase tracking-wider">
              [Local Review Draft]
            </span>
          </>
        )}
      </div>

      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-[#1c1917] dark:text-[#f0f6fc] leading-tight">
        {title}
      </h1>

      <p class="text-base text-[#78716c] dark:text-[#8b949e] leading-relaxed">
        {tagline}
      </p>

      <div class="flex flex-wrap items-center gap-4 pt-2">
        <a
          href={githubRepo}
          target="_blank"
          rel="noreferrer"
          class="flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-[#1c1917] dark:text-[#f0f6fc] bg-[#f2ede4] dark:bg-[#161b22] border border-[#e7e3da] dark:border-[#30363d] rounded-md hover:border-slate-400 dark:hover:border-slate-600 transition-colors"
        >
          <Github class="w-4 h-4" />
          <span>Reproducible Test Repository</span>
        </a>

        {relatedArticleSlug && (
          <a
            href={`/writing/${relatedArticleSlug}`}
            class="flex items-center gap-1.5 text-xs font-medium text-sky-600 dark:text-sky-400 hover:underline"
          >
            <BookOpen class="w-3.5 h-3.5" />
            <span>Read companion deep-dive essay</span>
          </a>
        )}
      </div>
    </header>

    <!-- Hypothesis Callout -->
    <div class="p-5 rounded-lg border border-sky-200 dark:border-sky-900/60 bg-sky-50/50 dark:bg-sky-950/20 text-xs sm:text-sm leading-relaxed">
      <div class="text-[11px] font-mono uppercase tracking-wider text-sky-700 dark:text-sky-300 font-semibold mb-1">
        Experimental Hypothesis
      </div>
      <p class="text-[#1c1917] dark:text-[#f0f6fc]">{hypothesis}</p>
    </div>

    <!-- Live Interactive Telemetry Simulator -->
    <div>
      <div class="flex items-center gap-2 pb-2 text-xs font-mono uppercase tracking-wider text-[#78716c] dark:text-[#8b949e]">
        <Sliders class="w-3.5 h-3.5 text-sky-500" />
        <span>Interactive Laboratory Simulation</span>
      </div>
      <ExperimentVisualizer client:visible type={interactiveType} />
    </div>

    <!-- MDX Content Body -->
    <div class="prose dark:prose-invert max-w-none text-xs sm:text-sm text-[#1c1917] dark:text-[#e6edf3]">
      <slot />
    </div>

    <!-- Methodology & Harness Setup -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-4">
      <div class="p-5 rounded-xl border border-[#e7e3da] dark:border-[#30363d] bg-[#ffffff] dark:bg-[#161b22] space-y-3">
        <h2 class="text-sm font-bold text-[#1c1917] dark:text-[#f0f6fc] uppercase tracking-wider font-mono">
          Test Harness Setup
        </h2>
        <p class="text-xs sm:text-sm text-[#78716c] dark:text-[#8b949e] leading-relaxed">
          {setup}
        </p>
      </div>

      <div class="p-5 rounded-xl border border-[#e7e3da] dark:border-[#30363d] bg-[#ffffff] dark:bg-[#161b22] space-y-3">
        <h2 class="text-sm font-bold text-[#1c1917] dark:text-[#f0f6fc] uppercase tracking-wider font-mono">
          Implementation Details
        </h2>
        <p class="text-xs sm:text-sm text-[#78716c] dark:text-[#8b949e] leading-relaxed">
          {implementation}
        </p>
      </div>
    </div>

    <!-- Key Findings -->
    <div class="space-y-4 pt-4">
      <h2 class="text-base font-bold text-[#1c1917] dark:text-[#f0f6fc] uppercase tracking-wider font-mono text-xs">
        Key Empirical Findings
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        {keyFindings.map((finding) => (
          <div
            class="p-4 rounded-lg border border-[#e7e3da] dark:border-[#30363d] bg-[#fdfdfc] dark:bg-[#161b22] flex items-start gap-3"
          >
            <CheckCircle2 class="w-4 h-4 text-emerald-500 shrink-0 mt-0.5" />
            <span class="text-xs sm:text-sm text-[#44403c] dark:text-[#c9d1d9] leading-relaxed">
              {finding}
            </span>
          </div>
        ))}
      </div>
    </div>

    <!-- Limitations -->
    {limitations.length > 0 && (
      <div class="space-y-3 pt-4">
        <h2 class="text-base font-bold text-[#1c1917] dark:text-[#f0f6fc] uppercase tracking-wider font-mono text-xs">
          Measurement Invariants & Limitations
        </h2>
        <ul class="space-y-2 text-xs sm:text-sm text-[#78716c] dark:text-[#8b949e]">
          {limitations.map((limit) => (
            <li class="flex items-start gap-2">
              <AlertCircle class="w-4 h-4 text-amber-500 shrink-0 mt-0.5" />
              <span>{limit}</span>
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>
</BaseLayout>
