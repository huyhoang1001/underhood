---
import BaseLayout from './BaseLayout.astro';
import { ArrowLeft, BookOpen, Sliders, CheckCircle2, AlertCircle, FlaskConical, Terminal } from '@lucide/astro';
import { Github } from 'lucide-react';
import { ExperimentVisualizer } from '../components/ExperimentVisualizer';

interface Props {
  title: string;
  tagline: string;
  date: string;
  topic: string;
  status: string;
  hypothesis: string;
  setup: string;
  implementation: string;
  keyFindings: string[];
  limitations?: string[];
  githubRepo: string;
  relatedArticleSlug?: string;
  interactiveType?: 'node-threadpool' | 'queue-backpressure' | 'grpc-multiplex' | 'cache-invalidation' | 'tokio-scheduler' | 'go-scheduler';
}

const {
  title,
  tagline,
  date,
  topic,
  status,
  hypothesis,
  setup,
  implementation,
  keyFindings,
  limitations = [],
  githubRepo,
  relatedArticleSlug,
  interactiveType = undefined
} = Astro.props;
---

<BaseLayout title={`${title} — Underhood Experiments`} description={tagline}>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-8 sm:py-12 space-y-8">

    <!-- Breadcrumb -->
    <a
      href="/experiments"
      class="inline-flex items-center gap-1.5 text-xs font-medium text-[#78716c] dark:text-[#8b949e] hover:text-[#1c1917] dark:hover:text-[#f0f6fc] transition-colors"
    >
      <ArrowLeft class="w-3.5 h-3.5" />
      <span>All laboratory experiments</span>
    </a>

    <!-- Header -->
    <header class="space-y-3 pb-6 border-b border-[#e7e3da] dark:border-[#30363d]">
      <div class="flex flex-wrap items-center gap-2 text-xs font-mono text-[#78716c] dark:text-[#8b949e]">
        <span class="inline-flex items-center gap-1 text-sky-600 dark:text-sky-400">
          <FlaskConical class="w-3 h-3" />
          <span class="uppercase tracking-wider text-[11px] font-semibold">Lab Experiment</span>
        </span>
        <span>·</span>
        <a
          href={`/topics/${topic}`}
          class="font-semibold text-sky-600 dark:text-sky-400 uppercase tracking-wider text-[11px] hover:underline"
        >
          {topic.replace(/-/g, ' ')}
        </a>
        <span>·</span>
        <span>{date}</span>
        {status === 'draft' && (
          <>
            <span>·</span>
            <span class="text-amber-700 dark:text-amber-400 font-semibold text-[11px] uppercase tracking-wider">
              [Draft]
            </span>
          </>
        )}
      </div>

      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-[#1c1917] dark:text-[#f0f6fc] leading-tight">
        {title}
      </h1>

      <p class="text-sm text-[#78716c] dark:text-[#8b949e] leading-relaxed max-w-3xl">
        {tagline}
      </p>

      <!-- Action links -->
      <div class="flex flex-wrap items-center gap-3 pt-1">
        <a
          href={githubRepo}
          target="_blank"
          rel="noreferrer"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-[#1c1917] dark:text-[#f0f6fc] bg-[#f2ede4] dark:bg-[#161b22] border border-[#e7e3da] dark:border-[#30363d] rounded-md hover:border-slate-400 dark:hover:border-slate-600 transition-colors"
        >
          <Github class="w-3.5 h-3.5" />
          <span>Run it yourself</span>
        </a>
        {relatedArticleSlug && (
          <a
            href={`/writing/${relatedArticleSlug}`}
            class="inline-flex items-center gap-1.5 text-xs font-medium text-sky-600 dark:text-sky-400 hover:underline"
          >
            <BookOpen class="w-3.5 h-3.5" />
            <span>Read the deep-dive essay</span>
          </a>
        )}
      </div>
    </header>

    <!-- Data grid: Hypothesis + Setup + Implementation -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div class="md:col-span-3 p-4 rounded-lg border border-sky-200 dark:border-sky-900/50 bg-sky-50/40 dark:bg-sky-950/20 space-y-1.5">
        <div class="text-[11px] font-mono uppercase tracking-wider text-sky-700 dark:text-sky-400 font-semibold">
          Hypothesis
        </div>
        <p class="text-xs sm:text-sm text-[#1c1917] dark:text-[#f0f6fc] leading-relaxed">
          {hypothesis}
        </p>
      </div>

      <div class="p-4 rounded-lg border border-[#e7e3da] dark:border-[#30363d] bg-[#ffffff] dark:bg-[#161b22] space-y-1.5">
        <div class="text-[11px] font-mono uppercase tracking-wider text-[#78716c] dark:text-[#8b949e] font-semibold">
          Environment
        </div>
        <p class="text-xs text-[#44403c] dark:text-[#c9d1d9] leading-relaxed">{setup}</p>
      </div>

      <div class="md:col-span-2 p-4 rounded-lg border border-[#e7e3da] dark:border-[#30363d] bg-[#ffffff] dark:bg-[#161b22] space-y-1.5">
        <div class="text-[11px] font-mono uppercase tracking-wider text-[#78716c] dark:text-[#8b949e] font-semibold">
          What Was Tested
        </div>
        <p class="text-xs text-[#44403c] dark:text-[#c9d1d9] leading-relaxed">{implementation}</p>
      </div>
    </div>

    {interactiveType && (
    <div class="space-y-2">
      <div class="flex items-center gap-2 text-[11px] font-mono uppercase tracking-wider text-[#78716c] dark:text-[#8b949e]">
        <Sliders class="w-3.5 h-3.5 text-sky-500" />
        <span>Interactive Simulation</span>
      </div>
      <ExperimentVisualizer client:visible type={interactiveType} />
    </div>
    )}
    <!-- Key Findings -->
    <div class="space-y-3">
      <div class="flex items-center gap-2 text-[11px] font-mono uppercase tracking-wider text-[#78716c] dark:text-[#8b949e]">
        <CheckCircle2 class="w-3.5 h-3.5 text-emerald-500" />
        <span>Empirical Findings — {keyFindings.length} verified results</span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        {keyFindings.map((finding, i) => (
          <div class="p-4 rounded-lg border border-[#e7e3da] dark:border-[#30363d] bg-[#fdfdfc] dark:bg-[#161b22] flex items-start gap-3">
            <span class="text-[11px] font-mono text-sky-600 dark:text-sky-400 font-bold shrink-0 mt-0.5 w-5">
              {String(i + 1).padStart(2, '0')}
            </span>
            <span class="text-xs text-[#44403c] dark:text-[#c9d1d9] leading-relaxed">
              {finding}
            </span>
          </div>
        ))}
      </div>
    </div>

    <!-- Limitations -->
    {limitations.length > 0 && (
      <div class="space-y-2">
        <div class="flex items-center gap-2 text-[11px] font-mono uppercase tracking-wider text-[#78716c] dark:text-[#8b949e]">
          <AlertCircle class="w-3.5 h-3.5 text-amber-500" />
          <span>Measurement Constraints</span>
        </div>
        <ul class="space-y-2">
          {limitations.map((limit) => (
            <li class="flex items-start gap-2 text-xs text-[#78716c] dark:text-[#8b949e] leading-relaxed">
              <span class="font-mono text-amber-500 shrink-0">—</span>
              <span>{limit}</span>
            </li>
          ))}
        </ul>
      </div>
    )}

    <!-- Reproduce it CTA -->
    <div class="flex items-center justify-between p-4 rounded-lg border border-[#e7e3da] dark:border-[#30363d] bg-[#f7f4ee] dark:bg-[#0d1117]">
      <div class="flex items-center gap-2 text-xs text-[#78716c] dark:text-[#8b949e]">
        <Terminal class="w-3.5 h-3.5" />
        <span class="font-mono">Clone and run the harness to verify these results on your own hardware</span>
      </div>
      <a
        href={githubRepo}
        target="_blank"
        rel="noreferrer"
        class="shrink-0 inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-sky-600 dark:text-sky-400 border border-sky-300 dark:border-sky-800 rounded-md hover:bg-sky-50 dark:hover:bg-sky-950/30 transition-colors"
      >
        <Github class="w-3.5 h-3.5" />
        View on GitHub
      </a>
    </div>

  </div>
</BaseLayout>
