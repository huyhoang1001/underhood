---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { FlaskConical, ArrowRight } from '@lucide/astro';

const experiments = await getCollection('experiments', ({ data }) => {
  return import.meta.env.DEV || data.status !== 'draft';
});

const sortedExperiments = experiments.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---

<BaseLayout title="Experiments — Underhood Engineering Lab" description="Reproducible empirical investigations into runtime internals, thread pool saturation, event loop delay, and concurrency limits.">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 space-y-10 py-8 sm:py-12">
    <div class="space-y-3 max-w-2xl">
      <div class="flex items-center gap-2 text-xs font-mono text-sky-600 dark:text-sky-400">
        <FlaskConical class="w-3.5 h-3.5" />
        <span>UNDERHOOD ENGINEERING LABORATORY</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-[#1c1917] dark:text-[#f0f6fc]">
        Experiments
      </h1>
      <p class="text-sm sm:text-base text-[#78716c] dark:text-[#8b949e] leading-relaxed">
        Reproducible empirical investigations into runtime internals, thread pool saturation, event loop delay, and concurrency limits.
      </p>
    </div>

    {sortedExperiments.length === 0 ? (
      <div class="py-16 sm:py-24 space-y-8 max-w-2xl mx-auto text-center">
        <div class="inline-flex p-3 rounded-full bg-sky-500/10 text-sky-500">
          <FlaskConical class="w-8 h-8" />
        </div>
        <div class="space-y-3">
          <h2 class="text-2xl font-bold tracking-tight text-[#1c1917] dark:text-[#f0f6fc]">
            Engineering Laboratory
          </h2>
          <p class="text-sm text-[#78716c] dark:text-[#8b949e] leading-relaxed">
            Laboratory experiments and reproducible harness benchmarks are currently undergoing peer verification.
          </p>
        </div>
      </div>
    ) : (
      <div class="grid grid-cols-1 gap-6">
        {sortedExperiments.map((exp) => (
          <article
            key={exp.slug}
            class="p-6 sm:p-8 rounded-xl border border-[#e7e3da] dark:border-[#30363d] bg-[#ffffff] dark:bg-[#161b22] hover:border-sky-500/50 transition-all space-y-4 shadow-2xs group"
          >
            <div class="flex flex-wrap items-center justify-between gap-2 text-xs">
              <a
                href={`/topics/${exp.data.topic}`}
                class="font-mono text-sky-600 dark:text-sky-400 uppercase tracking-wider text-[11px] hover:underline"
              >
                {exp.data.topic.replace(/-/g, ' ')}
              </a>
              <div class="flex items-center gap-2 font-mono text-[#a8a29e] dark:text-[#6e7681]">
                <span>Lab Run: {exp.data.date}</span>
                {exp.data.status === 'draft' && (
                  <span class="text-amber-700 dark:text-amber-400 font-semibold">
                    [Draft]
                  </span>
                )}
              </div>
            </div>

            <h2 class="text-xl sm:text-2xl font-bold text-[#1c1917] dark:text-[#f0f6fc] group-hover:text-sky-600 dark:group-hover:text-sky-400 transition-colors">
              <a href={`/experiments/${exp.slug}`}>{exp.data.title ?? exp.slug.split('-').map((w: string) => w.charAt(0).toUpperCase() + w.slice(1)).join(' ')}</a>
            </h2>

            <p class="text-sm text-[#78716c] dark:text-[#8b949e] leading-relaxed max-w-3xl">
              {exp.data.tagline}
            </p>

            <div class="p-4 rounded-lg bg-[#f7f4ee] dark:bg-[#0d1117] border border-[#e7e3da] dark:border-[#30363d] text-xs font-mono text-[#44403c] dark:text-[#c9d1d9] space-y-1">
              <div class="text-[11px] text-[#78716c] dark:text-[#8b949e]">
                Hypothesis:
              </div>
              <p class="line-clamp-2 leading-relaxed">{exp.data.hypothesis}</p>
            </div>

            <div class="flex items-center justify-between pt-2 text-xs font-semibold text-sky-600 dark:text-sky-400">
              <a
                href={`/experiments/${exp.slug}`}
                class="inline-flex items-center gap-1.5 hover:underline"
              >
                Launch interactive simulation <ArrowRight class="w-3.5 h-3.5" />
              </a>
              <span class="text-xs text-[#a8a29e] dark:text-[#6e7681] font-normal">
                {exp.data.keyFindings.length} verified findings
              </span>
            </div>
          </article>
        ))}
      </div>
    )}
  </div>
</BaseLayout>
