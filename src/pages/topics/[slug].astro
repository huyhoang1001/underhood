---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { TOPIC_LIST, TOPICS } from '../../data/topics';
import { calculateReadingTime } from '../../utils/readingTime';
import { ArrowLeft, ArrowRight } from '@lucide/astro';

export async function getStaticPaths() {
  return TOPIC_LIST.map((topic) => ({
    params: { slug: topic.id },
    props: { topic }
  }));
}

const { topic } = Astro.props;

const allArticles = await getCollection('articles', ({ data }) => {
  return import.meta.env.DEV || data.status !== 'draft';
});
const topicArticles = allArticles.filter((a) => a.data.topic === topic.id);

const allExperiments = await getCollection('experiments', ({ data }) => {
  return import.meta.env.DEV || data.status !== 'draft';
});
const topicExperiments = allExperiments.filter((e) => e.data.topic === topic.id);
---

<BaseLayout title={`${topic.name} — Underhood Domain Directory`} description={topic.description}>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 space-y-10 py-8 sm:py-12">
    <a
      href="/topics"
      class="inline-flex items-center gap-1.5 text-xs font-medium text-[#78716c] dark:text-[#8b949e] hover:text-[#1c1917] dark:hover:text-[#f0f6fc] transition-colors"
    >
      <ArrowLeft class="w-3.5 h-3.5" />
      <span>All topics directory</span>
    </a>

    <header class="space-y-3 max-w-3xl pb-8 border-b border-[#e7e3da] dark:border-[#30363d]">
      <div class="text-xs font-mono uppercase tracking-widest text-sky-600 dark:text-sky-400">
        Domain Focus
      </div>
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-[#1c1917] dark:text-[#f0f6fc]">
        {topic.name}
      </h1>
      <p class="text-base text-[#78716c] dark:text-[#8b949e] leading-relaxed">
        {topic.description}
      </p>
    </header>

    <!-- Topic Articles -->
    <div class="space-y-6">
      <div class="flex items-center justify-between pb-2 border-b border-[#e7e3da] dark:border-[#30363d] text-xs font-mono text-[#78716c] dark:text-[#8b949e]">
        <span>Published Essays ({topicArticles.length})</span>
      </div>

      {topicArticles.length === 0 ? (
        <div class="py-12 text-center text-sm text-[#78716c] dark:text-[#8b949e] max-w-lg mx-auto space-y-2">
          <p>No articles are currently published in this domain.</p>
          <p class="text-xs text-[#a8a29e] dark:text-[#6e7681]">
            Upcoming technical investigations and reproducible benchmarks for {topic.name} are undergoing peer reproduction.
          </p>
        </div>
      ) : (
        <div class="divide-y divide-[#e7e3da] dark:divide-[#30363d]">
          {topicArticles.map((art) => {
            const readingTimeInfo = calculateReadingTime(art.body || '');
            return (
              <article class="group py-6 first:pt-0 space-y-2">
                <div class="flex items-center gap-2 text-xs text-[#78716c] dark:text-[#8b949e]">
                  <span>{art.data.date}</span>
                  <span>·</span>
                  <span>{readingTimeInfo.formattedReadingTime}</span>
                  {art.data.status === 'draft' && (
                    <>
                      <span>·</span>
                      <span class="font-mono text-amber-700 dark:text-amber-400 font-semibold text-[11px] uppercase tracking-wider">
                        [Draft]
                      </span>
                    </>
                  )}
                </div>
                <h2 class="text-xl font-bold text-[#1c1917] dark:text-[#f0f6fc] group-hover:text-sky-600 dark:group-hover:text-sky-400 transition-colors">
                  <a href={`/writing/${art.slug}`}>{art.data.title ?? art.slug.split('-').map((w: string) => w.charAt(0).toUpperCase() + w.slice(1)).join(' ')}</a>
                </h2>
                <p class="text-sm text-[#78716c] dark:text-[#8b949e] leading-relaxed line-clamp-2">
                  {art.data.description}
                </p>
              </article>
            );
          })}
        </div>
      )}
    </div>

    <!-- Associated Experiments -->
    {topicExperiments.length > 0 && (
      <div class="space-y-4 pt-6">
        <div class="flex items-center justify-between pb-2 border-b border-[#e7e3da] dark:border-[#30363d] text-xs font-mono text-[#78716c] dark:text-[#8b949e]">
          <span>Associated Laboratory Experiments</span>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {topicExperiments.map((exp) => (
            <a
              href={`/experiments/${exp.slug}`}
              class="p-5 rounded-lg border border-[#e7e3da] dark:border-[#30363d] bg-[#ffffff] dark:bg-[#161b22] hover:border-sky-500/50 space-y-2 transition-colors block"
            >
              <h3 class="text-sm font-semibold text-[#1c1917] dark:text-[#f0f6fc]">
                {exp.data.title ?? exp.slug.split('-').map((w: string) => w.charAt(0).toUpperCase() + w.slice(1)).join(' ')}
              </h3>
              <p class="text-xs text-[#78716c] dark:text-[#8b949e] line-clamp-2 leading-relaxed">
                {exp.data.tagline}
              </p>
              <span class="inline-flex items-center gap-1 text-xs font-medium text-sky-600 dark:text-sky-400 pt-1">
                Launch simulation <ArrowRight class="w-3 h-3" />
              </span>
            </a>
          ))}
        </div>
      </div>
    )}
  </div>
</BaseLayout>
